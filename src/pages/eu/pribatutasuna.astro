---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PrivacyPolicy from '../../components/PrivacyPolicy.astro';
import t from '../../i18n/eu.json';

const lang = 'eu';
const p = t.privacy;
---
<Layout title={p.meta.title} description={p.meta.description} lang={lang}>
  <Navbar t={t.nav} theme={t.theme} lang={lang} />
  <main>
    <PrivacyPolicy lang={lang} title={p.title} updated={p.updated} intro={p.intro} sections={p.sections} back={p.back} />
  </main>
  <Footer t={t.footer} lang={lang} />
</Layout>

---
import '../styles/global.css';
import ContactModal from '../components/ContactModal.astro';
import es from '../i18n/es.json';
import ca from '../i18n/ca.json';
import eu from '../i18n/eu.json';
import gl from '../i18n/gl.json';
import type { Lang } from '../i18n/languages';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const contactModalByLang = { es, ca, eu, gl } as const;
const contactModal = contactModalByLang[lang].contactModal;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f2847" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="ca" href="https://mednode.es/ca/" />
    <link rel="alternate" hreflang="es" href="https://mednode.es/es/" />
    <link rel="alternate" hreflang="eu" href="https://mednode.es/eu/" />
    <link rel="alternate" hreflang="gl" href="https://mednode.es/gl/" />
    <link rel="alternate" hreflang="x-default" href="https://mednode.es/es/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,500&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MedNode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://mednode.es/img/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mednode.es/img/og-image.svg" />
  </head>
  <body class="theme-hospital bg-clinical-50 font-body text-slate-800 antialiased">
    <slot />
    <ContactModal m={contactModal} />
    <script src="/js/contact-modal.js?v=3" defer></script>
  </body>
</html>

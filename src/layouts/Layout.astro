---
import '../styles/global.css';
import ContactModal from '../components/ContactModal.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import es from '../i18n/es.json';
import ca from '../i18n/ca.json';
import eu from '../i18n/eu.json';
import gl from '../i18n/gl.json';
import type { Lang } from '../i18n/languages';

interface Props {
  title: string;
  description: string;
  lang: Lang;
}

const { title, description, lang } = Astro.props;
const contactModalByLang = { es, ca, eu, gl } as const;
const contactModal = contactModalByLang[lang].contactModal;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale: Record<Lang, string> = {
  es: 'es_ES',
  ca: 'ca_ES',
  eu: 'eu_ES',
  gl: 'gl_ES',
};
const ogImage = 'https://mednode.es/img/og-image.png';
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <script is:inline>
      (function () {
        var k = 'mednode-theme';
        var t;
        try {
          t = localStorage.getItem(k);
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0077B6" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="96x96" href="/img/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="ca" href="https://mednode.es/ca/" />
    <link rel="alternate" hreflang="es" href="https://mednode.es/es/" />
    <link rel="alternate" hreflang="eu" href="https://mednode.es/eu/" />
    <link rel="alternate" hreflang="gl" href="https://mednode.es/gl/" />
    <link rel="alternate" hreflang="x-default" href="https://mednode.es/es/" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,500&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MedNode" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <SchemaOrg lang={lang} />
  </head>
  <body class="theme-hospital font-body antialiased">
    <slot />
    <ContactModal m={contactModal} />
    <script src="/js/theme.js" defer></script>
    <script src="/js/contact-modal.js?v=3" defer></script>
  </body>
</html>

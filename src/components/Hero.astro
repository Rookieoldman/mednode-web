---
import NodesNetwork from './NodesNetwork.astro';

interface Props {
  t: { badge: string; title: string; subtitle: string; cta: string };
  exploreLabel: string;
}

const { t, exploreLabel } = Astro.props;
---
<section
  id="hero"
  class="relative overflow-hidden bg-gradient-to-br from-clinical-950 via-clinical-900 to-medblue-900 text-white"
>
  <div class="hospital-grid-bg pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -right-32 top-0 h-96 w-96 rounded-full bg-teal-hospital/20 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-medblue-500/15 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-12">
      <div class="animate-hospital-in">
        <p
          class="mb-5 inline-flex items-center gap-2 rounded-md border border-teal-hospital/40 bg-teal-hospital/10 px-4 py-1.5 text-sm font-semibold tracking-wide text-teal-hospital"
        >
          <span class="h-2 w-2 animate-pulse rounded-full bg-teal-hospital" aria-hidden="true"></span>
          {t.badge}
        </p>
        <h1
          class="font-heading text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl lg:text-[3.25rem]"
        >
          {t.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-clinical-100/90">
          {t.subtitle}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-open-contact
            class="btn-hospital-primary cursor-pointer rounded-lg px-8 py-3.5 font-heading text-base font-semibold text-white"
          >
            {t.cta}
          </button>
          <a
            href="#products"
            class="rounded-lg border border-white/25 px-6 py-3.5 font-heading text-sm font-semibold text-white transition hover:border-white/50 hover:bg-white/5"
          >
            {exploreLabel}
          </a>
        </div>
      </div>

      <div class="animate-hospital-in animate-hospital-in-delay-2 flex justify-center lg:justify-end">
        <div
          class="relative rounded-2xl border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur-md"
        >
          <div
            class="pointer-events-none absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-teal-hospital to-transparent opacity-80"
            style="animation: hospital-pulse-line 3s ease-in-out infinite"
            aria-hidden="true"
          ></div>
          <NodesNetwork />
        </div>
      </div>
    </div>
  </div>
</section>

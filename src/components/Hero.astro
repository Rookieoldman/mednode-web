---
import NodesNetwork from './NodesNetwork.astro';

interface Props {
  t: { badge: string; title: string; subtitle: string; cta: string };
  exploreLabel: string;
}

const { t, exploreLabel } = Astro.props;
---
<section id="hero" class="hero-hospital site-hero relative overflow-hidden">
  <div class="hero-hospital__bg pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hospital-grid-bg absolute inset-0 opacity-70"></div>
    <div class="hero-hospital__network">
      <NodesNetwork />
    </div>
    <div class="hero-hospital__glow hero-hospital__glow--teal"></div>
    <div class="hero-hospital__glow hero-hospital__glow--blue"></div>
    <div class="hero-hospital__scrim"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:py-32">
    <div class="animate-hospital-in max-w-2xl">
      <p
        class="hero-badge mb-5 inline-flex items-center gap-2 rounded-md border px-4 py-1.5 text-sm font-semibold tracking-wide"
      >
        <span class="h-2 w-2 animate-pulse rounded-full bg-teal-hospital" aria-hidden="true"></span>
        {t.badge}
      </p>
      <h1 class="font-heading text-4xl font-bold leading-[1.1] tracking-tight md:text-5xl lg:text-[3.25rem]">
        {t.title}
      </h1>
      <p class="hero-subtitle mt-6 text-lg leading-relaxed">
        {t.subtitle}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <button
          type="button"
          data-open-contact
          class="site-btn-primary cursor-pointer rounded-lg px-8 py-3.5 font-heading text-base font-semibold"
        >
          {t.cta}
        </button>
        <a href="#products" class="hero-explore rounded-lg border px-6 py-3.5 font-heading text-sm font-semibold transition">
          {exploreLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-hospital__bg {
    z-index: 0;
  }

  .hero-hospital__network {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.42;
  }

  .hero-hospital__network :global(.nodes-network) {
    width: min(52rem, 95vw);
    max-width: none;
    transform: scale(1.05);
  }

  .hero-hospital__network :global(.nodes-network__svg) {
    width: 100%;
    height: auto;
  }

  .hero-hospital__network :global(.network-link) {
    opacity: 0.55;
    stroke: #5eb8e8;
  }

  .hero-hospital__network :global(.network-link--delay-1),
  .hero-hospital__network :global(.network-link--delay-3) {
    stroke: #5eead4;
  }

  .hero-hospital__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .hero-hospital__glow--teal {
    right: 10%;
    top: 15%;
    height: 20rem;
    width: 20rem;
    background: rgba(13, 148, 136, 0.22);
  }

  .hero-hospital__glow--blue {
    left: -5%;
    bottom: 10%;
    height: 18rem;
    width: 18rem;
    background: rgba(0, 119, 182, 0.18);
  }

  .hero-hospital__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(8, 28, 51, 0.92) 0%,
      rgba(8, 28, 51, 0.75) 42%,
      rgba(15, 40, 71, 0.35) 68%,
      rgba(15, 40, 71, 0.15) 100%
    );
  }

  @media (min-width: 768px) {
    .hero-hospital__network {
      justify-content: flex-end;
      padding-right: 4%;
      opacity: 0.48;
    }

    .hero-hospital__network :global(.nodes-network) {
      width: min(44rem, 58vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-hospital__network :global(.network-link),
    .hero-hospital__network :global(.node-core),
    .hero-hospital__network :global(.node-ring) {
      animation: none;
    }

    .hero-hospital__network :global(.network-signals) {
      display: none;
    }
  }
</style>

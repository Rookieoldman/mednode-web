---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { Lang } from '../i18n/languages';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations['nav'];
  theme: Translations['theme'];
  lang: Lang;
}

const { t, theme, lang } = Astro.props;
---
<header class="site-header sticky top-0 z-50 border-b backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
    <Logo />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      <a href="#products" class="site-nav-link rounded-lg px-4 py-2 text-sm font-semibold transition">{t.products}</a>
      <a href="#advantages" class="site-nav-link rounded-lg px-4 py-2 text-sm font-semibold transition">{t.advantages}</a>
      <a href="#contact" class="site-nav-link rounded-lg px-4 py-2 text-sm font-semibold transition">{t.contact}</a>
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <ThemeToggle labels={theme} />
      <LanguageSwitcher lang={lang} />
    </div>

    <details class="relative md:hidden">
      <summary class="site-nav-summary list-none cursor-pointer rounded-lg border px-3 py-2 text-sm font-semibold">
        Menú
      </summary>
      <div class="site-nav-mobile absolute right-0 mt-2 w-56 rounded-xl border p-4 shadow-xl">
        <nav class="flex flex-col gap-1" aria-label="Mòbil">
          <a href="#products" class="site-nav-mobile-link rounded-lg px-3 py-2 font-semibold">{t.products}</a>
          <a href="#advantages" class="site-nav-mobile-link rounded-lg px-3 py-2 font-semibold">{t.advantages}</a>
          <a href="#contact" class="site-nav-mobile-link rounded-lg px-3 py-2 font-semibold">{t.contact}</a>
        </nav>
        <div class="site-nav-mobile-divider mt-4 flex items-center justify-between gap-3 border-t pt-4">
          <ThemeToggle labels={theme} />
          <LanguageSwitcher lang={lang} />
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  .site-nav-mobile-link {
    color: inherit;
  }

  [data-theme='dark'] .site-nav-mobile a.site-nav-mobile-link {
    color: #dceaf5;
  }

  [data-theme='light'] .site-nav-mobile a.site-nav-mobile-link {
    color: #475569;
  }
</style>

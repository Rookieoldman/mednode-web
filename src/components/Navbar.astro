---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Lang } from '../i18n/languages';

interface Props {
  t: { products: string; advantages: string; contact: string };
  lang: Lang;
}

const { t, lang } = Astro.props;
---
<header class="sticky top-0 z-50 bg-white shadow-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <Logo />

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      <a href="#products" class="font-semibold text-gray-700 hover:text-medblue-500 transition-colors">{t.products}</a>
      <a href="#advantages" class="font-semibold text-gray-700 hover:text-medblue-500 transition-colors">{t.advantages}</a>
      <a href="#contact" class="font-semibold text-gray-700 hover:text-medblue-500 transition-colors">{t.contact}</a>
    </nav>

    <div class="hidden md:block">
      <LanguageSwitcher lang={lang} />
    </div>

    <details class="relative md:hidden">
      <summary class="list-none cursor-pointer rounded-lg border border-gray-200 px-3 py-2 text-sm font-semibold text-medblue-900">
        Menú
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-xl border border-gray-200 bg-white p-4 shadow-lg">
        <nav class="flex flex-col gap-3" aria-label="Mòbil">
          <a href="#products" class="font-semibold text-gray-700">{t.products}</a>
          <a href="#advantages" class="font-semibold text-gray-700">{t.advantages}</a>
          <a href="#contact" class="font-semibold text-gray-700">{t.contact}</a>
        </nav>
        <div class="mt-4 border-t border-gray-100 pt-4">
          <LanguageSwitcher lang={lang} />
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>

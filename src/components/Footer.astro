---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import type { Lang } from '../i18n/languages';

interface Props {
  t: { tagline: string; copyright: string; marks: string };
  lang: Lang;
}

const { t, lang } = Astro.props;
---
<footer class="site-footer border-t py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex w-full items-center justify-between gap-4">
      <Logo class="opacity-95" />
      <LanguageSwitcher lang={lang} />
    </div>
    <div class="mt-10 space-y-2 text-center text-sm">
      <p class="footer-tagline font-medium">{t.tagline}</p>
      <p class="footer-copy">{t.copyright}</p>
      <p class="footer-marks mx-auto max-w-xl text-xs">{t.marks}</p>
    </div>
  </div>
</footer>

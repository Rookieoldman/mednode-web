---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import type { Lang } from '../i18n/languages';

interface Props {
  t: { tagline: string; copyright: string; marks: string };
  lang: Lang;
}

const { t, lang } = Astro.props;
---
<footer class="border-t border-white/10 bg-clinical-950 py-12 text-clinical-100">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-4 text-center sm:px-6">
    <Logo variant="light" class="opacity-95" />
    <LanguageSwitcher lang={lang} variant="footer" />
    <div class="space-y-2 text-sm">
      <p class="font-medium text-white/90">{t.tagline}</p>
      <p class="text-clinical-100/70">{t.copyright}</p>
      <p class="mx-auto max-w-xl text-xs text-clinical-100/55">{t.marks}</p>
    </div>
  </div>
</footer>

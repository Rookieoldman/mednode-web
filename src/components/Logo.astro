---
import MedNodeMark from './MedNodeMark.astro';

interface Props {
  class?: string;
  variant?: 'light' | 'dark';
}

const { class: className = '', variant = 'dark' } = Astro.props;
const textClass = variant === 'light' ? 'text-white' : 'text-medblue-900';
---
<a href="#hero" class={`inline-flex items-center gap-2.5 font-heading text-xl font-bold ${textClass} ${className}`}>
  <MedNodeMark class="h-9 w-9 shrink-0" animated />
  <span>MedNode</span>
</a>

---
import MedNodeMark from './MedNodeMark.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---
<a
  href="#hero"
  class={`site-logo inline-flex items-center gap-2.5 font-heading text-xl font-bold ${className}`}
>
  <MedNodeMark class="h-9 w-9 shrink-0" animated />
  <span>MedNode<sup class="ml-0.5 text-[0.55em] font-bold leading-none opacity-90" aria-hidden="true">®</sup></span>
</a>

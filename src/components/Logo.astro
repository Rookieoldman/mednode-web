---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<a href="#hero" class={`inline-flex items-center gap-2 font-heading font-bold text-medblue-900 text-xl ${className}`}>
  <svg class="h-9 w-9 shrink-0" viewBox="0 0 40 40" aria-hidden="true" fill="none">
    <circle cx="20" cy="10" r="5" class="fill-medblue-500" />
    <circle cx="10" cy="28" r="4.5" class="fill-mednode-500" />
    <circle cx="30" cy="28" r="4.5" class="fill-medblue-500" />
    <path d="M20 15 L12 24 M20 15 L28 24 M14 28 L26 28" stroke="#023E8A" stroke-width="2" stroke-linecap="round" opacity="0.4" />
  </svg>
  <span>MedNode</span>
</a>

---
import MedNodeMark from './MedNodeMark.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---
<a href="#hero" class={`inline-flex items-center gap-2.5 font-heading font-bold text-medblue-900 text-xl ${className}`}>
  <MedNodeMark class="h-9 w-9 shrink-0" animated />
  <span>MedNode</span>
</a>

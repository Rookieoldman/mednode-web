---
import type { Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}

const labels: Record<Lang, string[]> = {
  es: ['RGPD', 'eIDAS', 'On-premise', 'Integración HIS'],
  ca: ['RGPD', 'eIDAS', 'On-premise', 'Integració HIS'],
  eu: ['RGPD', 'eIDAS', 'On-premise', 'HIS integrazioa'],
  gl: ['RGPD', 'eIDAS', 'On-premise', 'Integración HIS'],
};

const { lang } = Astro.props;
const items = labels[lang] ?? labels.es;
---
<div
  class="border-y border-white/10 bg-clinical-950/80 backdrop-blur-sm"
  role="list"
  aria-label="Cumplimiento normativo"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-4 py-4 sm:px-6">
    {
      items.map((label) => (
        <span
          role="listitem"
          class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-clinical-100/90 sm:text-sm"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-teal-hospital shadow-[0_0_8px_rgba(13,148,136,0.8)]" />
          {label}
        </span>
      ))
    }
  </div>
</div>

---
/** Il·lustració SVG: xarxa de nodes interconnectats (animació tipus vídeo, sense JS). */
---
<div class="nodes-network" aria-hidden="true">
  <svg class="nodes-network__svg" viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="node-glow-blue" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#0077B6" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#0077B6" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="node-glow-green" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#2A9D8F" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#2A9D8F" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Enllaços (paths per animateMotion) -->
    <g class="network-links">
      <path id="link-hub-top" class="network-link" d="M120 118 L120 42" />
      <path id="link-hub-tr" class="network-link network-link--delay-1" d="M122 116 L178 68" />
      <path id="link-hub-br" class="network-link network-link--delay-2" d="M124 122 L172 178" />
      <path id="link-hub-bl" class="network-link network-link--delay-3" d="M116 124 L58 176" />
      <path id="link-hub-tl" class="network-link network-link--delay-4" d="M118 118 L62 72" />
      <path id="link-mid-1" class="network-link network-link--delay-2" d="M178 68 L198 128" />
      <path id="link-mid-2" class="network-link network-link--delay-3" d="M58 176 L42 128" />
      <path id="link-mid-3" class="network-link network-link--delay-1" d="M62 72 L42 108" />
      <path id="link-cross" class="network-link network-link--delay-4" d="M178 68 L62 72" opacity="0.5" />
    </g>

    <!-- Senyals que viatgen pels enllaços -->
    <g class="network-signals">
      <circle class="network-signal network-signal--blue" r="3.5" fill="#0077B6">
        <animateMotion dur="2.2s" repeatCount="indefinite" calcMode="linear">
          <mpath href="#link-hub-top" />
        </animateMotion>
      </circle>
      <circle class="network-signal network-signal--green" r="3" fill="#2A9D8F">
        <animateMotion dur="2.8s" repeatCount="indefinite" calcMode="linear" begin="0.4s">
          <mpath href="#link-hub-tr" />
        </animateMotion>
      </circle>
      <circle class="network-signal network-signal--blue" r="3" fill="#0077B6">
        <animateMotion dur="3s" repeatCount="indefinite" calcMode="linear" begin="0.9s">
          <mpath href="#link-hub-br" />
        </animateMotion>
      </circle>
      <circle class="network-signal network-signal--green" r="3.5" fill="#2A9D8F">
        <animateMotion dur="2.5s" repeatCount="indefinite" calcMode="linear" begin="0.2s">
          <mpath href="#link-hub-bl" />
        </animateMotion>
      </circle>
      <circle class="network-signal network-signal--dark" r="2.5" fill="#023E8A">
        <animateMotion dur="3.4s" repeatCount="indefinite" calcMode="linear" begin="1.1s">
          <mpath href="#link-cross" />
        </animateMotion>
      </circle>
      <circle class="network-signal network-signal--blue" r="2.5" fill="#0077B6">
        <animateMotion dur="2s" repeatCount="indefinite" calcMode="linear" begin="1.5s">
          <mpath href="#link-mid-1" />
        </animateMotion>
      </circle>
    </g>

    <!-- Nodes -->
    <g class="network-nodes">
      <circle class="node-glow" cx="120" cy="120" r="32" fill="url(#node-glow-blue)" />

      <g class="node-group" transform="translate(120 120)">
        <circle class="node-ring node-ring--hub" cx="0" cy="0" r="16" />
        <circle class="node-core node-core--hub" cx="0" cy="0" r="14" fill="#0077B6" />
      </g>
      <g class="node-group" transform="translate(120 38)">
        <circle class="node-ring node-ring--d1" cx="0" cy="0" r="11" />
        <circle class="node-core node-core--d1" cx="0" cy="0" r="9" fill="#0077B6" />
      </g>
      <g class="node-group" transform="translate(182 66)">
        <circle class="node-ring node-ring--d2" cx="0" cy="0" r="10" />
        <circle class="node-core node-core--d2" cx="0" cy="0" r="8" fill="#2A9D8F" />
      </g>
      <g class="node-group" transform="translate(200 128)">
        <circle class="node-ring node-ring--d3" cx="0" cy="0" r="9" />
        <circle class="node-core node-core--d3" cx="0" cy="0" r="7" fill="#0077B6" />
      </g>
      <g class="node-group" transform="translate(174 182)">
        <circle class="node-ring node-ring--d4" cx="0" cy="0" r="10" />
        <circle class="node-core node-core--d4" cx="0" cy="0" r="8" fill="#2A9D8F" />
      </g>
      <g class="node-group" transform="translate(56 178)">
        <circle class="node-ring node-ring--d5" cx="0" cy="0" r="9" />
        <circle class="node-core node-core--d5" cx="0" cy="0" r="7" fill="#0077B6" />
      </g>
      <g class="node-group" transform="translate(40 126)">
        <circle class="node-ring node-ring--d6" cx="0" cy="0" r="8" />
        <circle class="node-core node-core--d6" cx="0" cy="0" r="6" fill="#023E8A" opacity="0.85" />
      </g>
      <g class="node-group" transform="translate(60 70)">
        <circle class="node-ring node-ring--d7" cx="0" cy="0" r="9" />
        <circle class="node-core node-core--d7" cx="0" cy="0" r="7" fill="#2A9D8F" />
      </g>
      <g class="node-group" transform="translate(120 205)">
        <circle class="node-ring node-ring--d8" cx="0" cy="0" r="7" />
        <circle class="node-core node-core--d8" cx="0" cy="0" r="5.5" fill="#023E8A" opacity="0.7" />
      </g>
    </g>
  </svg>
</div>

<style>
  .nodes-network {
    width: 100%;
    max-width: 28rem;
  }

  .nodes-network__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .network-link {
    fill: none;
    stroke: #0077b6;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    opacity: 0.45;
    animation: link-draw 2.8s ease-in-out infinite;
  }

  .network-link--delay-1 { animation-delay: 0.35s; stroke: #2a9d8f; }
  .network-link--delay-2 { animation-delay: 0.7s; }
  .network-link--delay-3 { animation-delay: 1.05s; stroke: #2a9d8f; }
  .network-link--delay-4 { animation-delay: 1.4s; stroke: #023e8a; opacity: 0.35; }

  @keyframes link-draw {
    0% {
      stroke-dashoffset: 120;
      opacity: 0.15;
    }
    40% {
      stroke-dashoffset: 0;
      opacity: 0.55;
    }
    70% {
      stroke-dashoffset: 0;
      opacity: 0.45;
    }
    100% {
      stroke-dashoffset: -120;
      opacity: 0.15;
    }
  }

  .node-group {
    transform-origin: center;
    transform-box: fill-box;
  }

  .node-core {
    animation: node-breathe 2.4s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  .node-core--hub { animation-duration: 2s; }
  .node-core--d1 { animation-delay: 0.2s; }
  .node-core--d2 { animation-delay: 0.5s; }
  .node-core--d3 { animation-delay: 0.8s; }
  .node-core--d4 { animation-delay: 1.1s; }
  .node-core--d5 { animation-delay: 0.35s; }
  .node-core--d6 { animation-delay: 0.65s; }
  .node-core--d7 { animation-delay: 0.95s; }
  .node-core--d8 { animation-delay: 1.25s; }

  @keyframes node-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.12);
      opacity: 0.88;
    }
  }

  .node-ring {
    fill: none;
    stroke: #0077b6;
    stroke-width: 1.5;
    transform-origin: center;
    transform-box: fill-box;
    animation: ring-pulse 2.8s ease-out infinite;
  }

  .node-ring--hub {
    stroke: #2a9d8f;
    animation-duration: 2.2s;
  }
  .node-ring--d1 { animation-delay: 0s; }
  .node-ring--d2 { animation-delay: 0.4s; stroke: #2a9d8f; }
  .node-ring--d3 { animation-delay: 0.8s; }
  .node-ring--d4 { animation-delay: 1.2s; stroke: #2a9d8f; }
  .node-ring--d5 { animation-delay: 0.6s; }
  .node-ring--d6 { animation-delay: 1s; stroke: #023e8a; }
  .node-ring--d7 { animation-delay: 1.4s; stroke: #2a9d8f; }
  .node-ring--d8 { animation-delay: 1.8s; stroke: #023e8a; }

  @keyframes ring-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
      stroke-width: 2;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
      stroke-width: 0.5;
    }
  }

  .network-signal {
    opacity: 0.95;
    filter: drop-shadow(0 0 3px rgba(0, 119, 182, 0.5));
  }

  .network-signal--green {
    filter: drop-shadow(0 0 3px rgba(42, 157, 143, 0.5));
  }

  @media (prefers-reduced-motion: reduce) {
    .network-link,
    .node-core,
    .node-ring {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 0.4;
    }

    .network-signals {
      display: none;
    }
  }
</style>

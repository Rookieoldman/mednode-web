---
interface Props {
  t: {
    title: string;
    subtitle: string;
    cta: string;
    email: string;
    hint: string;
  };
}

const { t } = Astro.props;
---
<section id="contact" class="bg-clinical-950 py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <div
      class="rounded-2xl border border-white/10 bg-gradient-to-b from-clinical-900 to-clinical-950 p-10 shadow-2xl md:p-14"
    >
      <h2 class="font-heading text-3xl font-bold text-white md:text-4xl">{t.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-clinical-100/85">{t.subtitle}</p>
      <p class="mt-6">
        <a
          href={`mailto:${t.email}`}
          class="text-lg font-semibold text-teal-hospital transition hover:text-white"
        >
          {t.email}
        </a>
      </p>
      <button
        type="button"
        data-open-contact
        class="btn-hospital-primary mt-10 cursor-pointer rounded-lg px-12 py-4 font-heading text-lg font-semibold text-white"
      >
        {t.cta}
      </button>
      <p class="mt-6 text-sm text-clinical-100/60" set:html={t.hint} />
    </div>
  </div>
</section>

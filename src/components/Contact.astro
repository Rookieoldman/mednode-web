---
interface Props {
  t: {
    title: string;
    subtitle: string;
    cta: string;
    email: string;
    hint: string;
  };
}

const { t } = Astro.props;
---
<section id="contact" class="site-contact py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <div class="site-contact-panel rounded-2xl border p-10 md:p-14">
      <h2 class="font-heading text-3xl font-bold md:text-4xl">{t.title}</h2>
      <p class="contact-sub mt-4 text-lg leading-relaxed">{t.subtitle}</p>
      <p class="mt-6">
        <a href={`mailto:${t.email}`} class="contact-email text-lg font-semibold transition">
          {t.email}
        </a>
      </p>
      <button
        type="button"
        data-open-contact
        class="site-btn-primary mt-10 cursor-pointer rounded-lg px-12 py-4 font-heading text-lg font-semibold"
      >
        {t.cta}
      </button>
      <p class="contact-hint mt-6 text-sm" set:html={t.hint} />
    </div>
  </div>
</section>

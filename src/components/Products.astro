---
interface Product {
  name: string;
  tagline: string;
  description: string;
  features: string[];
}

interface Props {
  t: {
    title: string;
    medsign: Product;
    medflow: Product;
  };
}

const { t } = Astro.props;
---
<section id="products" class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-center font-heading text-3xl font-bold text-medblue-900 md:text-4xl">{t.title}</h2>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <article class="rounded-xl border border-gray-200 p-8 transition-shadow hover:shadow-lg">
        <div class="mb-5 flex gap-3 text-medblue-500" aria-hidden="true">
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19h16M6 16l4-8 4 5 4-9" />
          </svg>
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="2" width="16" height="20" rx="2" />
            <path d="M8 10h8M8 14h5" />
          </svg>
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12l4 4L19 6" />
          </svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-medblue-900">
          {t.medsign.name}<sup class="text-xs font-bold text-mednode-500">®</sup>
        </h3>
        <p class="mt-1 font-semibold text-mednode-500">{t.medsign.tagline}</p>
        <p class="mt-3 text-gray-600">{t.medsign.description}</p>
        <ul class="mt-6 space-y-2">
          {t.medsign.features.map((f) => (
            <li class="flex gap-2 text-sm text-gray-700">
              <svg class="h-5 w-5 shrink-0 text-mednode-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rounded-xl border border-gray-200 p-8 transition-shadow hover:shadow-lg">
        <div class="mb-5 flex gap-3 text-mednode-500" aria-hidden="true">
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="6" cy="18" r="2" />
            <circle cx="18" cy="6" r="2" />
            <path d="M8 16l8-8" />
          </svg>
          <svg class="h-9 w-9 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 21h18M6 21V9l6-4 6 4v12" />
            <path d="M10 14h4v7h-4z" />
          </svg>
        </div>
        <h3 class="font-heading text-xl font-bold text-medblue-900">
          {t.medflow.name}<sup class="text-xs font-bold text-mednode-500">®</sup>
        </h3>
        <p class="mt-1 font-semibold text-mednode-500">{t.medflow.tagline}</p>
        <p class="mt-3 text-gray-600">{t.medflow.description}</p>
        <ul class="mt-6 space-y-2">
          {t.medflow.features.map((f) => (
            <li class="flex gap-2 text-sm text-gray-700">
              <svg class="h-5 w-5 shrink-0 text-mednode-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

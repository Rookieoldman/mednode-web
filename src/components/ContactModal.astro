---
/** Modal de contacto (HTML estático) — el JS solo abre/cierra y valida. */
const FORMSUBMIT_ACTION = 'https://formsubmit.co/1b11f3f7b22760ae01e4c7d13e05d2b1';

export interface ContactModalCopy {
  title: string;
  intro: string;
  name: string;
  namePh: string;
  email: string;
  emailPh: string;
  org: string;
  orgPh: string;
  message: string;
  messagePh: string;
  send: string;
  gmail: string;
  close: string;
  subject: string;
  autoresponse: string;
  privacyPrefix: string;
  privacyLink: string;
  privacyHref: string;
  required: string;
  invalidEmail: string;
  privacyRequired: string;
  sending: string;
  success: string;
  error: string;
}

interface Props {
  m: ContactModalCopy;
}

const { m } = Astro.props;
---
<div
  id="contact-modal"
  class="contact-modal"
  hidden
  data-msg-required={m.required}
  data-msg-invalid-email={m.invalidEmail}
  data-msg-privacy-required={m.privacyRequired}
  data-msg-sending={m.sending}
  data-msg-success={m.success}
  data-msg-error={m.error}
  data-label-send={m.send}
  data-subject={m.subject}
>
  <div class="contact-modal__backdrop" data-close-contact tabindex="-1"></div>
  <div
    class="contact-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="contact-modal-title"
  >
    <button
      type="button"
      class="contact-modal__close"
      data-close-contact
      aria-label={m.close}>&times;</button
    >
    <h2 id="contact-modal-title" class="contact-modal__title">{m.title}</h2>
    <p class="contact-modal__intro">{m.intro}</p>
    <form
      class="contact-form"
      id="contact-form"
      method="POST"
      action={FORMSUBMIT_ACTION}
      accept-charset="UTF-8"
      novalidate
    >
      <input type="hidden" name="_subject" value={m.subject} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_autoresponse" value={m.autoresponse} />
      <input type="hidden" name="_next" id="contact-form-next" value="" />
      <input
        type="text"
        name="_gotcha"
        class="contact-form__honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <div class="contact-form__field">
        <label for="contact-name">{m.name} <span aria-hidden="true">*</span></label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          autocomplete="name"
          placeholder={m.namePh}
        />
      </div>
      <div class="contact-form__field">
        <label for="contact-email">{m.email} <span aria-hidden="true">*</span></label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          autocomplete="email"
          placeholder={m.emailPh}
        />
      </div>
      <div class="contact-form__field">
        <label for="contact-org">{m.org}</label>
        <input
          type="text"
          id="contact-org"
          name="organization"
          autocomplete="organization"
          placeholder={m.orgPh}
        />
      </div>
      <div class="contact-form__field">
        <label for="contact-message">{m.message} <span aria-hidden="true">*</span></label>
        <textarea
          id="contact-message"
          name="message"
          rows="4"
          required
          placeholder={m.messagePh}></textarea>
      </div>
      <div class="contact-form__consent">
        <input
          type="checkbox"
          id="contact-privacy"
          name="privacy_accepted"
          value="yes"
          required
        />
        <label for="contact-privacy">
          {m.privacyPrefix}<a href={m.privacyHref} target="_blank" rel="noopener noreferrer"
            >{m.privacyLink}</a
          > <span aria-hidden="true">*</span>
        </label>
      </div>
      <p class="contact-form__status" id="contact-form-status" role="status" aria-live="polite"></p>
      <div class="contact-form__actions">
        <button type="submit" class="btn btn-primary" id="contact-submit">{m.send}</button>
        <a
          class="btn btn-secondary contact-form__gmail"
          id="contact-gmail"
          href="#"
          target="_blank"
          rel="noopener noreferrer">{m.gmail}</a
        >
      </div>
    </form>
  </div>
</div>

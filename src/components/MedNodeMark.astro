---
/** Marca MedNode: hub central + nodes interconnectats (com la animació del hero). */
interface Props {
  class?: string;
  /** Subtil pulsació al node central (navbar). */
  animated?: boolean;
}

const { class: className = 'h-9 w-9', animated = false } = Astro.props;
---
<svg
  class:list={[className, animated && 'mednode-mark--animated']}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g class="mednode-mark__links" stroke-linecap="round">
    <line x1="16" y1="16" x2="16" y2="5" stroke="#0077B6" stroke-width="1.25" opacity="0.5" />
    <line x1="16" y1="16" x2="25" y2="9" stroke="#2A9D8F" stroke-width="1.25" opacity="0.45" />
    <line x1="16" y1="16" x2="26" y2="18" stroke="#0077B6" stroke-width="1.25" opacity="0.4" />
    <line x1="16" y1="16" x2="22" y2="26" stroke="#2A9D8F" stroke-width="1.25" opacity="0.45" />
    <line x1="16" y1="16" x2="7" y2="24" stroke="#0077B6" stroke-width="1.25" opacity="0.4" />
    <line x1="16" y1="16" x2="6" y2="14" stroke="#023E8A" stroke-width="1.1" opacity="0.35" />
    <line x1="16" y1="16" x2="8" y2="8" stroke="#2A9D8F" stroke-width="1.1" opacity="0.4" />
    <line x1="25" y1="9" x2="8" y2="8" stroke="#023E8A" stroke-width="1" opacity="0.25" />
  </g>
  <circle cx="8" cy="8" r="2.75" fill="#2A9D8F" />
  <circle cx="16" cy="5" r="3" fill="#0077B6" />
  <circle cx="25" cy="9" r="2.5" fill="#2A9D8F" />
  <circle cx="26" cy="18" r="2.25" fill="#0077B6" />
  <circle cx="22" cy="26" r="2.5" fill="#2A9D8F" />
  <circle cx="7" cy="24" r="2.25" fill="#0077B6" />
  <circle cx="6" cy="14" r="2" fill="#023E8A" opacity="0.9" />
  <circle class="mednode-mark__hub" cx="16" cy="16" r="4.25" fill="#0077B6" />
</svg>

<style>
  .mednode-mark--animated .mednode-mark__hub {
    transform-origin: center;
    transform-box: fill-box;
    animation: mark-hub-pulse 2.2s ease-in-out infinite;
  }

  @keyframes mark-hub-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mednode-mark--animated .mednode-mark__hub {
      animation: none;
    }
  }
</style>

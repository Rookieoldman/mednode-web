---
import { langCodes, languages, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<nav class="site-lang flex items-center gap-1 text-sm font-semibold" aria-label="Idioma">
  {
    langCodes.map((code, i) => (
      <>
        {i > 0 && <span class="site-lang-sep" aria-hidden="true">|</span>}
        {code === lang ? (
          <span class="site-lang-current rounded px-2 py-1" aria-current="page">
            {languages[code].flag}
          </span>
        ) : (
          <a href={`/${code}/`} hreflang={code} class="rounded px-2 py-1 transition-colors">
            {languages[code].flag}
          </a>
        )}
      </>
    ))
  }
</nav>

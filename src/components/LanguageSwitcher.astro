---
import { langCodes, languages, type Lang } from '../i18n/languages';

interface Props {
  lang: Lang;
  variant?: 'header' | 'footer';
}

const { lang, variant = 'header' } = Astro.props;
const isFooter = variant === 'footer';
---
<nav
  class:list={[
    'flex items-center gap-1 text-sm font-semibold',
    isFooter ? 'text-medblue-200' : 'text-gray-600',
  ]}
  aria-label="Idioma"
>
  {
    langCodes.map((code, i) => (
      <>
        {i > 0 && <span class={isFooter ? 'text-medblue-400' : 'text-gray-300'} aria-hidden="true">|</span>}
        {code === lang ? (
          <span
            class:list={[
              'px-2 py-1 rounded',
              isFooter ? 'text-white bg-white/15' : 'text-medblue-500 bg-medblue-50',
            ]}
            aria-current="page"
          >
            {languages[code].flag}
          </span>
        ) : (
          <a
            href={`/${code}/`}
            hreflang={code}
            class:list={[
              'px-2 py-1 rounded transition-colors',
              isFooter
                ? 'text-medblue-200 hover:text-white hover:bg-white/10'
                : 'text-gray-600 hover:text-medblue-500 hover:bg-medblue-50',
            ]}
          >
            {languages[code].flag}
          </a>
        )}
      </>
    ))
  }
</nav>
